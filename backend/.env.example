# Backend Environment Variables Example

# Server Configuration
APP_NAME="Donor Darah Lamongan API"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=donor_darah_lamongan

# JWT Authentication
SECRET_KEY=change_this_to_a_very_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Mock PMI API URL (For integration testing)
PMI_API_BASE_URL=http://localhost:8001
PMI_API_KEY=dummy-pmi-secret-key
